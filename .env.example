# Every address people use to reach the app, with https://. Requests for any other address are refused.
ALLOWED_HOSTS=https://hermes.tail36fb9.ts.net:8447,https://trackerr.example.com,http://127.0.0.1:3457

# Optional: also listen on this machine's Tailscale IP (port 8448), and add http://<ip>:8448 to ALLOWED_HOSTS.
# Useful when a device can't resolve the ts.net name.
TAILSCALE_IP=

# Spotify app from https://developer.spotify.com/dashboard (owner needs Premium).
# Add these redirect URIs to it: https://hermes.tail36fb9.ts.net:8447/auth/spotify/callback
#                                https://trackerr.example.com/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. Similar songs/artists and genre fallback. Free key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional. Shared token for the Discover playlist; each person can also add their own in Settings.
# Free token: https://listenbrainz.org/settings/
LISTENBRAINZ_TOKEN=

# Cloudflare Zero Trust > Networks > Tunnels > create tunnel > copy the token.
# Point the tunnel's public hostname at http://app:3000
CLOUDFLARE_TUNNEL_TOKEN=
